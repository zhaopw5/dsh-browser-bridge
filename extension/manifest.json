{
  "manifest_version": 3,
  "name": "DSH 抓页",
  "version": "0.3.0",
  "description": "把当前标签页渲染后的正文交给本机 DSH（不读 cookie、不联网）。",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": ["http://127.0.0.1:38999/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "DSH 抓页",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-now": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "不弹面板，直接抓当前页"
    }
  }
}
